<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="0dp">
        <shape>
            <solid android:color="#22A46B48" />
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
        </shape>
    </item>

    <item android:top="2dp">
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#FFF7F1"
                android:endColor="#FFE7DC"
                android:startColor="#FFFFFF" />
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#FFF9F4" />
        </shape>
    </item>

    <item
        android:left="18dp"
        android:top="4dp"
        android:right="18dp"
        android:bottom="58dp">
        <shape>
            <solid android:color="#55FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
