<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="5dp"
        android:right="1dp">
        <shape>
            <solid android:color="#E7C6B5" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="4dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#FFE8DE"
                android:startColor="#FFFFFF" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#F1D0C0" />
        </shape>
    </item>
</layer-list>
