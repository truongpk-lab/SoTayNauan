<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="8dp"
        android:right="2dp">
        <shape>
            <solid android:color="#B46938" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="6dp">
        <shape>
            <gradient
                android:angle="135"
                android:centerColor="#F59D51"
                android:endColor="#FEDB61"
                android:startColor="#D95F30" />
            <corners android:radius="28dp" />
            <padding
                android:bottom="22dp"
                android:left="22dp"
                android:right="22dp"
                android:top="22dp" />
        </shape>
    </item>

    <item
        android:left="16dp"
        android:top="8dp"
        android:right="16dp"
        android:bottom="94dp">
        <shape>
            <solid android:color="#35FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="6dp">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#FFFFE5" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
