<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="5dp"
        android:right="1dp">
        <shape>
            <solid android:color="#D3A083" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="4dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#FFE3D5"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#B96E35" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="30dp">
        <shape>
            <solid android:color="#66FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
