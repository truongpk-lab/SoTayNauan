<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="5dp"
        android:right="2dp">
        <shape>
            <solid android:color="#C88566" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="4dp">
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#FFDCCB"
                android:endColor="#F2A783"
                android:startColor="#FFF8F2" />
            <corners android:radius="24dp" />
            <padding
                android:bottom="8dp"
                android:left="10dp"
                android:right="10dp"
                android:top="8dp" />
        </shape>
    </item>

    <item
        android:left="4dp"
        android:top="3dp"
        android:right="4dp"
        android:bottom="21dp">
        <shape>
            <solid android:color="#44FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="4dp">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#FFFFF8" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
