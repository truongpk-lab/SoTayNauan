<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/back_to_ai_chef"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flowIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_ai_badge"
            android:gravity="center"
            android:textColor="@color/primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="@color/on_surface"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flowDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="17sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/flowState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_soft_panel"
            android:padding="18dp"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/flowActionButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/ai_flow_continue"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
