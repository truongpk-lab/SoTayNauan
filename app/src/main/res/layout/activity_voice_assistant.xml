<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageView
        android:id="@+id/voiceKitchenBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.42"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/cooking_step_preview" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66FFF8F6" />

    <TextView
        android:id="@+id/voiceCloseButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_voice_close"
        android:elevation="6dp"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/on_surface"
        android:textSize="36sp" />

    <TextView
        android:id="@+id/voiceSettingsButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_voice_close"
        android:elevation="6dp"
        android:gravity="center"
        android:text="⚙"
        android:textColor="@color/on_surface"
        android:textSize="26sp" />

    <LinearLayout
        android:id="@+id/voiceSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_voice_sheet"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <View
            android:layout_width="48dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_voice_handle" />

        <TextView
            android:id="@+id/voiceContextText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/voiceWave"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:gravity="center|bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/voiceWaveOne"
                android:layout_width="6dp"
                android:layout_height="10dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_voice_mic" />

            <TextView
                android:id="@+id/voiceWaveTwo"
                android:layout_width="6dp"
                android:layout_height="22dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_voice_mic" />

            <TextView
                android:id="@+id/voiceWaveThree"
                android:layout_width="6dp"
                android:layout_height="14dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_voice_mic" />

            <TextView
                android:id="@+id/voiceWaveFour"
                android:layout_width="6dp"
                android:layout_height="24dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_voice_mic" />

            <TextView
                android:id="@+id/voiceWaveFive"
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_voice_mic" />
        </LinearLayout>

        <TextView
            android:id="@+id/voiceStatusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voiceStatusSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/on_surface_variant"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_voice_transcript_card"
            android:orientation="horizontal"
            android:padding="24dp">

            <TextView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_voice_icon_circle"
                android:gravity="center"
                android:text="♨"
                android:textColor="@color/on_primary"
                android:textSize="25sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/voiceTranscriptLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đã nhận"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voiceTranscriptText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/on_surface"
                    android:textSize="23sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/voiceResponseText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/voiceMicButton"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_voice_mic"
            android:elevation="10dp"
            android:gravity="center"
            android:text="🎙"
            android:textColor="@color/on_primary"
            android:textSize="48sp" />

        <LinearLayout
            android:id="@+id/voiceQuickCommands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_voice_toggle_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="🔊"
                android:textColor="@color/primary"
                android:textSize="28sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Tự động đọc hướng dẫn"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/voiceAutoReadSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
